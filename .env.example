# Copia este archivo a .env y completa los valores:  cp .env.example .env
# Usa solo letras y números en las contraseñas de Mongo (van dentro de una URL).

DOMAIN=barberia.tudominio.com

MONGO_USER=barberia
MONGO_PASSWORD=cambia_esto_por_una_clave_larga

ADMIN_EMAIL=admin@barbershop.com
ADMIN_PASSWORD=cambia_esto

# Mínimo 32 caracteres. Genera una con:  openssl rand -base64 48
JWT_SECRET=

# Google Cloud Console -> APIs y servicios -> Credenciales
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
